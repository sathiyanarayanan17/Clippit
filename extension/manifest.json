{
  "manifest_version": 3,
  "name": "Clippit: Scam Guard",
  "version": "0.1.0",
  "description": "Silent until it sees a scam. Then it pauses the payment button. Runs fully on your device.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Clippit",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["detector.js", "i18n.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
