{
  "enabled": true,
  "name": "Clippit quiet-guard check",
  "description": "Re-runs the evaluation whenever the detector or dataset changes. Fails if the holdout set has any false alarm.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["extension/detector.js", "eval/dataset.json"]
  },
  "then": {
    "type": "runCommand",
    "command": "node eval/run.js"
  }
}
